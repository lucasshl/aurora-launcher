{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora Launcher",
  "version": "0.1.0",
  "identifier": "com.aurora.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora Launcher",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://mc-heads.net https://textures.minecraft.net https://cdn.modrinth.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://mc-heads.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NDY2ODMzNjU4OTk2MTIKUldRU2xvbGxNMmhHOUEwek95d09jNm40Uk1nN25iM3BDcDNWcTFVb3p6SHp1WlBsSXp1eWtzOFYK",
      "endpoints": [
        "https://github.com/lucasshl/aurora-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
